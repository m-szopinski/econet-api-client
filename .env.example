## Minimal environment for demos (fill with your own values)

# Auth
ECONET_USERNAME=
ECONET_PASSWORD=

# AWS/Cognito
AWS_REGION=eu-central-1
USER_POOL_ID=<your-user-pool-id>
USER_POOL_WEB_CLIENT_ID=<your-user-pool-web-client-id>
USER_IDENTITY_POOL_ID=<your-identity-pool-id>
AWS_IOT_ENDPOINT=wss://<your-endpoint>-ats.iot.${AWS_REGION}.amazonaws.com/mqtt

# API bases (no trailing slash)
AWS_API_ENDPOINT=https://<your-api-id>.execute-api.${AWS_REGION}.amazonaws.com/prod
ECONET_API_ENDPOINT=https://api.econetcloud.eu

# Optional website base
ECONET_SITE=https://econetcloud.eu
